---
interface Props {
  class?: string;
  tone?: string;
  chip?: string;
  edge?: string;
}

const { class: className = '', tone = '#C8874A', chip = '#3A0A10', edge = '#9C5F2B' } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <circle cx="32" cy="32" r="30" fill={tone} />
  <circle cx="32" cy="32" r="29" stroke={edge} stroke-width="2" opacity="0.55" />
  <circle cx="21" cy="22" r="4.2" fill={chip} />
  <circle cx="43" cy="19" r="3.1" fill={chip} />
  <circle cx="45" cy="41" r="4.4" fill={chip} />
  <circle cx="24" cy="43" r="3.2" fill={chip} />
  <circle cx="33" cy="31" r="2.6" fill={chip} />
  <circle cx="19" cy="33" r="1.7" fill={chip} opacity="0.75" />
  <circle cx="36" cy="47" r="1.6" fill={chip} opacity="0.7" />
  <circle cx="39" cy="28" r="1.5" fill={chip} opacity="0.65" />
</svg>
