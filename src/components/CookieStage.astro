---
/**
 * CookieStage
 * -----------
 * Lienzo WebGL fijo por encima de los fondos y por debajo de la navegación.
 * La galleta desciende con el scroll, gira sobre sí misma y se mantiene
 * visible hasta el final de la página. Su tamaño y su posición se calculan
 * según el ancho de pantalla para no tapar el contenido.
 */
---

<div id="cookie-stage" aria-hidden="true">
  <div id="cookie-glow"></div>
  <div id="cookie-shadow"></div>
  <canvas id="cookie-canvas"></canvas>
</div>

<div id="cookie-loader">
  <div class="flex flex-col items-center gap-5">
    <span class="loader-cookie relative block h-24 w-24 overflow-hidden rounded-full border border-vino/15 bg-blush p-2 shadow-[0_18px_40px_-20px_rgba(42,25,0,0.5)]">
      <img src="/logo-mark.png" alt="" class="h-full w-full object-contain" />
    </span>
    <p class="font-display text-sm font-semibold tracking-[0.3em] uppercase text-vino/60">
      Horneando la experiencia…
    </p>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { OBJLoader } from 'three/examples/jsm/loaders/OBJLoader.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  type Keyframe = {
    p: number;
    y: number;
    s: number;
    drift: number;
    tiltX: number;
    tiltY: number;
  };

  const stage = document.getElementById('cookie-stage') as HTMLDivElement | null;
  const canvas = document.getElementById('cookie-canvas') as HTMLCanvasElement | null;
  const glow = document.getElementById('cookie-glow') as HTMLDivElement | null;
  const shadow = document.getElementById('cookie-shadow') as HTMLDivElement | null;
  const loader = document.getElementById('cookie-loader') as HTMLDivElement | null;

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const finishLoading = () => {
    window.setTimeout(() => {
      loader?.classList.add('is-done');
      stage?.classList.add('is-ready');
    }, 350);
  };

  if (!stage || !canvas) {
    finishLoading();
  } else {
    try {
      init();
    } catch (error) {
      console.error('[CookieStage] WebGL no disponible', error);
      stage.remove();
      finishLoading();
    }
  }

  function init() {
    if (!stage || !canvas) return;

    /* ---------------------------------------------------------------- */
    /* Renderer                                                          */
    /* ---------------------------------------------------------------- */
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 0.88;

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(
      38,
      window.innerWidth / window.innerHeight,
      0.1,
      100,
    );
    camera.position.set(0, 0, 8.5);

    // Entorno suave para que el material tenga reflejos ricos
    try {
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      scene.environmentIntensity = 0.22;
      pmrem.dispose();
    } catch {
      /* el entorno es opcional */
    }

    /* ---------------------------------------------------------------- */
    /* Luces                                                             */
    /* ---------------------------------------------------------------- */
    const hemi = new THREE.HemisphereLight(0xfff4e6, 0x8a5a44, 0.75);
    scene.add(hemi);

    const keyLight = new THREE.DirectionalLight(0xfff1dd, 2.0);
    keyLight.position.set(4.5, 6, 6);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0xffc2d1, 0.7);
    fillLight.position.set(-6, 1.5, 3);
    scene.add(fillLight);

    const rimLight = new THREE.DirectionalLight(0xffb3a0, 1.1);
    rimLight.position.set(-3, -5, -5);
    scene.add(rimLight);

    const backLight = new THREE.DirectionalLight(0xffe2c4, 0.8);
    backLight.position.set(2, 3, -6);
    scene.add(backLight);

    /* ---------------------------------------------------------------- */
    /* Jerarquía: root → flip (giro 3D) → tilt → spin → modelo           */
    /* ---------------------------------------------------------------- */
    const root = new THREE.Group();
    const flip = new THREE.Group();
    const tilt = new THREE.Group();
    const spin = new THREE.Group();
    const model = new THREE.Group();

    root.add(flip);
    flip.add(tilt);
    tilt.add(spin);
    spin.add(model);
    scene.add(root);

    // El OBJ está tumbado en el plano XZ: lo ponemos de frente a la cámara
    model.rotation.x = Math.PI / 2;

    /* ---------------------------------------------------------------- */
    /* Textura procedural de galleta                                     */
    /* ---------------------------------------------------------------- */
    function createCookieTexture() {
      const size = 1024;
      const c = document.createElement('canvas');
      c.width = size;
      c.height = size;
      const ctx = c.getContext('2d')!;

      // Base
      const base = ctx.createRadialGradient(
        size * 0.42,
        size * 0.36,
        40,
        size * 0.5,
        size * 0.5,
        size * 0.78,
      );
      base.addColorStop(0, '#d89a5a');
      base.addColorStop(0.5, '#bd7638');
      base.addColorStop(1, '#94551f');
      ctx.fillStyle = base;
      ctx.fillRect(0, 0, size, size);

      // Poros / migas
      for (let i = 0; i < 9000; i++) {
        const x = Math.random() * size;
        const y = Math.random() * size;
        const r = Math.random() * 3 + 0.4;
        const dark = Math.random() > 0.45;
        ctx.fillStyle = dark
          ? `rgba(120, 66, 24, ${Math.random() * 0.26})`
          : `rgba(250, 214, 160, ${Math.random() * 0.32})`;
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
      }

      // Grietas suaves
      ctx.strokeStyle = 'rgba(112, 60, 22, 0.2)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 26; i++) {
        let x = Math.random() * size;
        let y = Math.random() * size;
        ctx.beginPath();
        ctx.moveTo(x, y);
        for (let j = 0; j < 6; j++) {
          x += (Math.random() - 0.5) * 70;
          y += (Math.random() - 0.5) * 70;
          ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      // Chispas de chocolate
      for (let i = 0; i < 85; i++) {
        const x = Math.random() * size;
        const y = Math.random() * size;
        const r = 12 + Math.random() * 30;
        const chip = ctx.createRadialGradient(x - r * 0.3, y - r * 0.3, r * 0.1, x, y, r);
        chip.addColorStop(0, '#74402a');
        chip.addColorStop(0.5, '#3f1a10');
        chip.addColorStop(1, '#240b07');
        ctx.fillStyle = chip;
        ctx.beginPath();
        ctx.ellipse(
          x,
          y,
          r,
          r * (0.7 + Math.random() * 0.5),
          Math.random() * Math.PI,
          0,
          Math.PI * 2,
        );
        ctx.fill();

        // Brillo húmedo
        ctx.fillStyle = 'rgba(255, 214, 190, 0.2)';
        ctx.beginPath();
        ctx.ellipse(
          x - r * 0.32,
          y - r * 0.35,
          r * 0.22,
          r * 0.14,
          -0.6,
          0,
          Math.PI * 2,
        );
        ctx.fill();
      }

      // Viñeta cálida en el borde para dar volumen
      const edge = ctx.createRadialGradient(
        size * 0.5,
        size * 0.5,
        size * 0.28,
        size * 0.5,
        size * 0.5,
        size * 0.52,
      );
      edge.addColorStop(0, 'rgba(90, 45, 15, 0)');
      edge.addColorStop(1, 'rgba(90, 45, 15, 0.28)');
      ctx.fillStyle = edge;
      ctx.fillRect(0, 0, size, size);

      const texture = new THREE.CanvasTexture(c);
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.RepeatWrapping;
      texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
      return texture;
    }

    const cookieTexture = createCookieTexture();

    const cookieMaterial = new THREE.MeshStandardMaterial({
      map: cookieTexture,
      bumpMap: cookieTexture,
      bumpScale: 0.025,
      color: 0xffffff,
      roughness: 0.96,
      metalness: 0.0,
      flatShading: false,
      envMapIntensity: 0.35,
    });

    /* ---------------------------------------------------------------- */
    /* Carga del modelo                                                  */
    /* ---------------------------------------------------------------- */
    let cookie: THREE.Object3D | null = null;

    new OBJLoader().load(
      '/models/galleta.obj',
      (object) => {
        object.traverse((child) => {
          if ((child as THREE.Mesh).isMesh) {
            const mesh = child as THREE.Mesh;
            mesh.material = cookieMaterial;
            mesh.castShadow = false;
            mesh.receiveShadow = false;
          }
        });

        // Centrar y normalizar a 2 unidades de diámetro
        const box = new THREE.Box3().setFromObject(object);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());
        object.position.sub(center);

        const maxDim = Math.max(size.x, size.y, size.z);
        object.scale.setScalar(2 / maxDim);

        cookie = object;
        model.add(object);
        finishLoading();
      },
      undefined,
      (error) => {
        console.error('[CookieStage] No se pudo cargar la galleta', error);
        finishLoading();
      },
    );

    /* ---------------------------------------------------------------- */
    /* Recorrido de scroll (p = progreso global 0 → 1)                   */
    /* y = posición vertical (0 = centro, 1 = borde superior)            */
    /* s = multiplicador de tamaño                                       */
    /* ---------------------------------------------------------------- */
    const desktopKeys: Keyframe[] = [
      { p: 0.0, y: 0.14, s: 1.0, drift: 0, tiltX: 0.16, tiltY: -0.4 },
      { p: 0.1, y: 0.11, s: 1.01, drift: 0.004, tiltX: 0.1, tiltY: -0.2 },
      { p: 0.22, y: 0.07, s: 1.0, drift: 0.012, tiltX: 0.05, tiltY: 0.2 },
      { p: 0.38, y: 0.02, s: 0.97, drift: 0.016, tiltX: 0.02, tiltY: -0.25 },
      { p: 0.52, y: -0.03, s: 0.94, drift: 0.008, tiltX: 0.0, tiltY: 0.3 },
      { p: 0.66, y: -0.08, s: 0.9, drift: -0.004, tiltX: 0.04, tiltY: 0.1 },
      { p: 0.78, y: -0.13, s: 0.87, drift: -0.012, tiltX: 0.08, tiltY: -0.3 },
      { p: 0.88, y: -0.17, s: 0.84, drift: -0.006, tiltX: 0.1, tiltY: -0.4 },
      { p: 0.96, y: -0.2, s: 0.82, drift: 0.0, tiltX: 0.08, tiltY: -0.15 },
      { p: 1.0, y: -0.22, s: 0.81, drift: 0.004, tiltX: 0.06, tiltY: 0.05 },
    ];

    const mobileKeys: Keyframe[] = [
      { p: 0.0, y: 0.31, s: 1.18, drift: 0, tiltX: 0.16, tiltY: -0.35 },
      { p: 0.1, y: 0.28, s: 1.17, drift: 0.004, tiltX: 0.1, tiltY: -0.15 },
      { p: 0.22, y: 0.22, s: 1.14, drift: 0.008, tiltX: 0.05, tiltY: 0.2 },
      { p: 0.38, y: 0.13, s: 1.1, drift: 0.01, tiltX: 0.02, tiltY: -0.2 },
      { p: 0.52, y: 0.05, s: 1.06, drift: 0.006, tiltX: 0.0, tiltY: 0.25 },
      { p: 0.66, y: -0.03, s: 1.03, drift: -0.002, tiltX: 0.04, tiltY: 0.1 },
      { p: 0.78, y: -0.11, s: 1.01, drift: -0.008, tiltX: 0.08, tiltY: -0.25 },
      { p: 0.88, y: -0.17, s: 1.0, drift: -0.004, tiltX: 0.1, tiltY: -0.35 },
      { p: 0.96, y: -0.22, s: 0.99, drift: 0.0, tiltX: 0.08, tiltY: -0.1 },
      { p: 1.0, y: -0.25, s: 0.98, drift: 0.004, tiltX: 0.06, tiltY: 0.05 },
    ];

    const smootherstep = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);

    function sample(keys: Keyframe[], p: number) {
      if (p <= keys[0].p) return keys[0];
      if (p >= keys[keys.length - 1].p) return keys[keys.length - 1];

      let i = 0;
      while (i < keys.length - 1 && p > keys[i + 1].p) i++;

      const a = keys[i];
      const b = keys[i + 1];
      const t = smootherstep((p - a.p) / (b.p - a.p));

      return {
        p,
        y: a.y + (b.y - a.y) * t,
        s: a.s + (b.s - a.s) * t,
        drift: a.drift + (b.drift - a.drift) * t,
        tiltX: a.tiltX + (b.tiltX - a.tiltX) * t,
        tiltY: a.tiltY + (b.tiltY - a.tiltY) * t,
      };
    }

    /* ---------------------------------------------------------------- */
    /* Estado                                                            */
    /* ---------------------------------------------------------------- */
    const state = {
      y: 0,
      s: 1,
      drift: 0,
      side: 1,
      tiltX: 0,
      tiltY: 0,
    };

    const target = { ...state };

    const pointer = { x: 0, y: 0 };
    let scrollProgress = 0;

    /* Lados del recorrido: cada sección indica si la galleta pasa por su
       izquierda o por su derecha, para dibujar el zigzag sin tapar texto. */
    type SideSection = { top: number; bottom: number; side: number };
    let sideSections: SideSection[] = [];
    let crossBoundaries: number[] = [];

    const measureSides = () => {
      sideSections = Array.from(document.querySelectorAll<HTMLElement>('[data-cookie]')).map(
        (el) => {
          const rect = el.getBoundingClientRect();
          const top = rect.top + window.scrollY;
          return {
            top,
            bottom: top + rect.height,
            side: el.dataset.cookie === 'left' ? -1 : 1,
          };
        },
      );

      // Solo hay cruce donde dos secciones seguidas usan lados distintos.
      crossBoundaries = [];
      for (let i = 0; i < sideSections.length - 1; i++) {
        const a = sideSections[i];
        const b = sideSections[i + 1];
        if (a.side !== b.side) crossBoundaries.push((a.bottom + b.top) / 2);
      }
    };

    const updateTargets = () => {
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      scrollProgress = Math.min(1, Math.max(0, window.scrollY / maxScroll));

      const keys = window.innerWidth < 1024 ? mobileKeys : desktopKeys;
      const k = sample(keys, scrollProgress);

      const parallax = prefersReduced ? 0 : 1;

      target.y = k.y + pointer.y * 0.008 * parallax;
      target.s = k.s;
      target.drift = k.drift + pointer.x * 0.008 * parallax;
      // La galleta se mantiene casi de frente: solo un inclinación fija y suave.
      target.tiltX = 0.06;
      target.tiltY = 0;
    };

    /* ---------------------------------------------------------------- */
    /* Eventos                                                           */
    /* ---------------------------------------------------------------- */
    const onScroll = () => updateTargets();

    const onPointerMove = (event: PointerEvent) => {
      pointer.x = (event.clientX / window.innerWidth) * 2 - 1;
      pointer.y = -(event.clientY / window.innerHeight) * 2 + 1;
    };

    const onResize = () => {
      const width = window.innerWidth;
      const height = window.innerHeight;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(width, height);

      measureSides();
      updateTargets();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('pointermove', onPointerMove, { passive: true });
    window.addEventListener('resize', onResize);
    window.addEventListener('load', measureSides);
    document.fonts?.ready.then(measureSides);

    measureSides();
    updateTargets();

    /* ---------------------------------------------------------------- */
    /* Loop de animación                                                 */
    /* ---------------------------------------------------------------- */
    let raf = 0;
    let last = performance.now();
    let worldHeight = 1;
    let worldWidth = 1;

    const clock = new THREE.Clock();

    const render = (now: number) => {
      raf = requestAnimationFrame(render);

      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;

      // Suavizado independiente del framerate
      const ease = 1 - Math.exp(-dt * 5.5);
      state.y += (target.y - state.y) * ease;
      state.s += (target.s - state.s) * ease;
      state.drift += (target.drift - state.drift) * ease;
      state.tiltX += (target.tiltX - state.tiltX) * ease;
      state.tiltY += (target.tiltY - state.tiltY) * ease;

      // Dimensiones del plano z=0 para traducir fracciones de pantalla
      const width = window.innerWidth;
      const height = window.innerHeight;
      worldHeight = 2 * Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)) * camera.position.z;
      worldWidth = worldHeight * camera.aspect;

      // Tamaño y posición según el tipo de pantalla
      const isDesktop = width >= 1024;
      let diameterPx: number;

      if (isDesktop) {
        diameterPx = Math.min(Math.max(Math.min(height * 0.5, width * 0.36), 300), 520);
      } else if (width < 640) {
        diameterPx = Math.min(Math.max(width * 0.25, 88), 110);
      } else {
        diameterPx = Math.min(Math.max(width * 0.25, 110), 140);
      }

      const radiusPx = (diameterPx * state.s) / 2;
      const edgeMargin = isDesktop ? 40 : 14;

      // Lado actual: la sección que hay bajo la galleta decide izquierda/derecha
      const focusY = window.scrollY + (0.5 - state.y) * height;
      let sideTarget = sideSections.length ? sideSections[sideSections.length - 1].side : 1;

      for (const section of sideSections) {
        if (focusY >= section.top && focusY < section.bottom) {
          sideTarget = section.side;
          break;
        }
      }

      state.side += (sideTarget - state.side) * (1 - Math.exp(-dt * 10));

      /* Al cambiar de lado la galleta cruza el centro de la sección. La
         encogemos un poco cerca de esos cruces para que pase por el aire
         de los márgenes sin tapar el contenido de ninguna de las dos. */
      let crossScale = 1;
      if (crossBoundaries.length) {
        const minScale = isDesktop ? 0.38 : 0.72;
        const zone = radiusPx * (isDesktop ? 2.4 : 1.6);

        for (const boundary of crossBoundaries) {
          const distance = Math.abs(focusY - boundary);
          if (distance < zone) {
            const t = Math.min(1, Math.max(0, (distance / zone - 0.18) / 0.82));
            const eased = t * t * (3 - 2 * t);
            crossScale = Math.min(crossScale, minScale + (1 - minScale) * eased);
          }
        }
      }

      const drawRadius = radiusPx * crossScale;

      let leftCenter: number;
      let rightCenter: number;

      if (isDesktop) {
        const containerWidth = Math.min(width, 1216);
        const containerLeft = (width - containerWidth) / 2;
        leftCenter = containerLeft + edgeMargin + drawRadius;
        rightCenter = containerLeft + containerWidth - edgeMargin - drawRadius;
      } else {
        leftCenter = edgeMargin + drawRadius;
        rightCenter = width - edgeMargin - drawRadius;
      }

      const sideT = (state.side + 1) / 2;
      const centerX = leftCenter + (rightCenter - leftCenter) * sideT + state.drift * width;
      const scale = (diameterPx * state.s * crossScale * worldHeight) / (2 * height);

      root.position.set((centerX / width - 0.5) * worldWidth, state.y * worldHeight, 0);
      root.scale.setScalar(scale);

      // Giro continuo y suave de 360° mientras baja; sin vaivenes bruscos.
      const t = clock.getElapsedTime();
      const motion = prefersReduced ? 0 : 1;

      flip.rotation.y = 0;
      tilt.rotation.x = state.tiltX;
      tilt.rotation.y = state.tiltY;
      spin.rotation.z = t * 0.45 * motion + scrollProgress * Math.PI * 2;

      const xPx = (root.position.x / worldWidth + 0.5) * width;
      const yPx = (-root.position.y / worldHeight + 0.5) * height;

      if (glow) {
        glow.style.transform = `translate3d(${xPx}px, ${yPx}px, 0) scale(${(drawRadius * 2.8) / 544})`;
        glow.style.opacity = '0.16';
      }

      if (shadow) {
        shadow.style.transform = `translate3d(${xPx}px, ${yPx + drawRadius * 0.85}px, 0) scale(${(drawRadius * 1.9) / 384})`;
        shadow.style.opacity = '0.8';
      }

      renderer.render(scene, camera);
    };

    raf = requestAnimationFrame(render);

    /* ---------------------------------------------------------------- */
    /* Limpieza                                                          */
    /* ---------------------------------------------------------------- */
    window.addEventListener(
      'pagehide',
      () => {
        cancelAnimationFrame(raf);
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('resize', onResize);
        cookieTexture.dispose();
        cookieMaterial.dispose();
        renderer.dispose();
      },
      { once: true },
    );
  }
</script>
