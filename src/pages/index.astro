---
import Layout from '../layouts/Layout.astro';
import CookieStage from '../components/CookieStage.astro';
import CookieMark from '../components/CookieMark.astro';

const sabores = [
  {
    nombre: 'Chocochips',
    desc: 'Mantequilla marrón y chispas de chocolate 70% cacao. El clásico que nunca falla.',
    tone: '#D99A5B',
    chip: '#3A0A10',
    fondo: 'bg-butter',
    tag: 'El clásico',
    nota: 'Chispas 70% cacao',
  },
  {
    nombre: 'Vainilla',
    desc: 'Vainilla de Madagascar, borde crujiente y centro mantecoso. Suave de verdad.',
    tone: '#E8C48E',
    chip: '#7A3E1D',
    fondo: 'bg-blush',
    tag: 'La suave',
    nota: 'Vainilla natural',
  },
];

const pasos = [
  {
    n: '01',
    titulo: 'Masa que reposa 24 horas',
    texto:
      'Dejamos la masa madurar en frío para que el azúcar se disuelva y el sabor se vuelva más profundo.',
  },
  {
    n: '02',
    titulo: 'Horneado en lotes pequeños',
    texto:
      'Cada bandeja sale del horno con el centro todavía suave. Nada de galletas secas ni de producción en serie.',
  },
  {
    n: '03',
    titulo: 'Chispas que se derriten',
    texto:
      'Cacao seleccionado que se funde en el momento exacto. El primer mordisco debe estirar un poco.',
  },
];

const stats = [
  { valor: '2', label: 'Sabores' },
  { valor: '3', label: 'Por combo' },
  { valor: '$2.50', label: 'El combo' },
];

/* Contacto y enlaces reales */
const whatsappNumber = '584122237479';
const whatsappText =
  '¡Hola! Quiero pedir el combo de 3 galletas por $2.50. ¿Qué sabores hay hoy?';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappText)}`;
const instagramUrl = 'https://instagram.com/quegalleta.mcbo';
const instagramHandle = '@quegalleta.mcbo';
const location = 'Maracaibo, Zulia · Venezuela';
const authorInstagram = 'https://instagram.com/jferr3r';
const authorGithub = 'https://github.com/JFerrerSis';
---

<Layout title="¡Qué Galleta! — Chocochips y vainilla, recién horneadas">
  <CookieStage />

  <div class="grain"></div>

  <!-- ================= NAV ================= -->
  <header id="nav" class="fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-5 sm:pt-4">
    <nav
      class="mx-auto flex h-14 max-w-[72rem] items-center justify-between gap-3 rounded-full border border-vino/15 bg-cream/92 px-3 shadow-[0_16px_36px_-24px_rgba(42,25,0,0.45)] backdrop-blur-xl transition-all duration-300 sm:h-16 sm:px-5"
    >
      <a href="#top" class="group flex items-center gap-2 sm:gap-2.5" aria-label="¡Qué Galleta! inicio">
        <span
          class="relative block h-9 w-9 shrink-0 overflow-hidden rounded-full border border-vino/15 bg-blush shadow-sm sm:h-10 sm:w-10"
        >
          <img
            src="/logo-mark.png"
            alt=""
            width="80"
            height="80"
            class="h-full w-full scale-[1.12] object-contain transition-transform duration-500 group-hover:scale-[1.22]"
          />
        </span>
        <span class="font-display text-[0.78rem] font-black uppercase tracking-tight sm:text-lg">¡Qué Galleta!</span>
      </a>

      <div class="hidden items-center gap-8 text-sm font-medium md:flex">
        <a href="#proceso" class="transition-colors hover:text-caramel-dark">El proceso</a>
        <a href="#sabores" class="transition-colors hover:text-caramel-dark">Sabores</a>
        <a href="#feed" class="transition-colors hover:text-caramel-dark">Síguenos</a>
        <a href="#pedir" class="transition-colors hover:text-caramel-dark">Contacto</a>
      </div>

      <a href="#pedir" class="btn-primary px-3.5! py-2! text-[0.68rem]! sm:px-5! sm:py-2.5! sm:text-sm!">
        Pedir ahora
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  </header>

  <main id="top" class="relative z-10">
    <!-- ================= HERO ================= -->
    <section
      data-cookie="right"
      class="relative flex min-h-[100svh] items-start pb-16 pt-[max(12rem,27svh)] lg:items-center lg:py-0"
    >
      <div class="container-page">
        <div data-hero class="max-w-[34rem]">
          <span class="pill">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-vino"></span>
            Horneadas hoy · combo de 3 por $2.50
          </span>

          <h1
            class="mt-5 font-display text-[clamp(2.7rem,10vw,6.6rem)] font-black leading-[0.9] tracking-[-0.03em] text-balance sm:mt-6 sm:leading-[0.88]"
          >
            Amor a la<br />
            <span class="italic text-caramel-dark">primera</span><br />
            mordida.
          </h1>

          <p class="mt-7 max-w-md text-base leading-relaxed text-vino sm:text-lg">
            Chocochips y vainilla, recién horneadas. Crujientes por fuera, con un corazón
            totalmente suave. Pide tu combo de 3 y arma tu mix.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href="#sabores" class="btn-primary">
              Ver sabores
              <span aria-hidden="true">→</span>
            </a>
            <a href="#proceso" class="btn-ghost">
              <span aria-hidden="true">↓</span>
              Cómo las hacemos
            </a>
          </div>

          <dl class="mt-12 flex max-w-md divide-x divide-vino/15 border-t border-vino/15 pt-6">
            {
              stats.map((stat) => (
                <div class="flex-1 pr-3 first:pl-0 [&:not(:first-child)]:pl-4 sm:pr-4 sm:[&:not(:first-child)]:pl-6">
                  <dt class="font-display text-xl font-black tracking-tight sm:text-2xl">{stat.valor}</dt>
                  <dd class="mt-0.5 text-[0.58rem] font-semibold uppercase tracking-[0.1em] text-vino/75 sm:text-[0.7rem] sm:tracking-[0.16em]">
                    {stat.label}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- ================= MARQUEE ================= -->
    <div class="relative z-10 overflow-hidden border-y border-vino/10 bg-butter py-4 text-vino">
      <div class="marquee-track flex w-max items-center gap-10 whitespace-nowrap">
        {
          [0, 1].map(() => (
            <div class="flex items-center gap-10">
              {[
                'Chocochips',
                'Vainilla',
                'Combo de 3 por $2.50',
                'Horneado diario',
                'Lotes pequeños',
                '100% artesanal',
              ].map((item) => (
                <span class="flex items-center gap-10">
                  <span class="font-display text-sm font-semibold uppercase tracking-[0.22em]">
                    {item}
                  </span>
                  <span class="text-base text-caramel-dark">✦</span>
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <!-- ================= SHOWCASE (3D + SCROLL) ================= -->
    <section id="proceso" data-cookie="right" class="relative z-10 h-[250vh]">
      <div class="sticky top-0 flex h-[100svh] items-center overflow-hidden pt-20 pb-10 lg:pt-0 lg:pb-0">
        <div class="container-page w-full">
          <div class="max-w-md">
            <span class="pill">El proceso</span>
            <h2
              class="mt-6 font-display text-[clamp(2.6rem,5vw,4.6rem)] font-black leading-[0.92] tracking-[-0.03em]"
            >
              Del horno<br />
              <span class="italic text-caramel-dark">a tu boca.</span>
            </h2>

            <div class="mt-7 flex max-w-md flex-col gap-2">
              {
                pasos.map((paso, i) => (
                  <article
                    class:list={['step', { 'is-active': i === 0 }]}
                    data-step={i}
                    data-text={paso.texto}
                  >
                    <div class="flex items-center gap-3">
                      <span class="step-num font-display text-xs font-bold text-caramel-dark">{paso.n}</span>
                      <span class="step-rule h-px flex-1 bg-vino/15" />
                      <span class="step-meta text-[0.6rem] font-semibold uppercase tracking-[0.2em]">
                        0{i + 1} / 03
                      </span>
                    </div>
                    <h3 class="step-title mt-1.5 font-display text-base font-bold leading-tight tracking-tight lg:text-lg">
                      {paso.titulo}
                    </h3>
                    <p class="step-text mt-1.5 hidden text-[0.82rem] leading-relaxed lg:block">{paso.texto}</p>
                  </article>
                ))
              }
            </div>

            <p
              id="step-detail"
              class="step-detail mt-4 max-w-md text-[0.85rem] leading-relaxed text-vino lg:hidden"
            >
              {pasos[0].texto}
            </p>

            <div class="mt-5 h-px w-full max-w-sm overflow-hidden bg-vino/15">
              <div id="showcase-bar" class="showcase-bar-fill h-px w-full bg-vino"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= FEATURES ================= -->
    <section data-cookie="left" class="relative z-10 border-y border-vino/10 py-16 sm:py-24">
      <div class="container-page">
        <div class="max-w-[34rem] lg:ml-auto">
          <span class="pill">La diferencia</span>
          <h2
            class="reveal mt-6 font-display text-[clamp(2.2rem,4.4vw,3.6rem)] font-black leading-[0.95] tracking-[-0.03em]"
          >
            ¿Por qué saben<br />
            <span class="italic text-caramel-dark">tan bien?</span>
          </h2>
        </div>

        <div class="mt-12 grid max-w-[34rem] grid-cols-1 gap-4 lg:ml-auto">
          {
            [
              {
                icono: '🍫',
                titulo: 'Chocolate real',
                texto:
                  'Chispas de cacao seleccionado que se derriten en cada bocado. Nada de sucedáneos.',
              },
              {
                icono: '🔥',
                titulo: 'Horneado diario',
                texto:
                  'Lotes pequeños cada mañana para garantizar frescura absoluta. Si no es de hoy, no sale.',
              },
              {
                icono: '🥄',
                titulo: 'Receta secreta',
                texto:
                  'El balance perfecto entre mantequilla artesanal, azúcar mascabado y una pizca de sal.',
              },
            ].map((item, i) => (
              <article
                class="card-soft reveal p-5 sm:p-6"
                data-reveal
                style={`transition-delay:${i * 70}ms`}
              >
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blush text-xl sm:h-12 sm:w-12 sm:rounded-2xl sm:text-2xl">
                    {item.icono}
                  </span>
                  <h3 class="font-display text-lg font-bold tracking-tight sm:text-xl">{item.titulo}</h3>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-vino">{item.texto}</p>
              </article>
            ))
          }
        </div>

        <div
          class="reveal mt-10 grid max-w-[34rem] grid-cols-3 gap-2 border-t border-vino/15 pt-8 text-center sm:mt-12 sm:gap-6 sm:pt-10 lg:ml-auto"
          data-reveal
        >
          <div>
            <p class="font-display text-xl font-black tracking-tight sm:text-3xl md:text-4xl">100%</p>
            <p class="mt-1 text-[0.55rem] font-semibold uppercase tracking-[0.12em] text-vino/75 sm:text-[0.65rem] sm:tracking-[0.2em]">
              Artesanal
            </p>
          </div>
          <div class="border-x border-vino/15">
            <p class="font-display text-xl font-black tracking-tight sm:text-3xl md:text-4xl">+4.000</p>
            <p class="mt-1 text-[0.55rem] font-semibold uppercase tracking-[0.12em] text-vino/75 sm:text-[0.65rem] sm:tracking-[0.2em]">
              Mordidas felices
            </p>
          </div>
          <div>
            <p class="font-display text-xl font-black tracking-tight sm:text-3xl md:text-4xl">24 h</p>
            <p class="mt-1 text-[0.55rem] font-semibold uppercase tracking-[0.12em] text-vino/75 sm:text-[0.65rem] sm:tracking-[0.2em]">
              Entrega local
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= SABORES ================= -->
    <section id="sabores" data-cookie="right" class="relative z-10 py-16 sm:py-28">
      <div class="container-page">
        <div class="max-w-[34rem]">
          <span class="pill">El menú</span>
          <h2
            class="reveal mt-6 font-display text-[clamp(2.4rem,5vw,4.2rem)] font-black leading-[0.92] tracking-[-0.03em]"
          >
            Dos clásicos,<br />
            <span class="italic text-caramel-dark">un solo combo.</span>
          </h2>
          <p class="reveal mt-5 max-w-md text-sm leading-relaxed text-vino" data-reveal>
            Solo horneamos dos sabores. Los hacemos tan bien que no nos hace falta más.
          </p>
        </div>

        <div class="mt-12 grid max-w-[34rem] grid-cols-1 gap-4">
          {
            sabores.map((sabor, i) => (
              <article
                class="card-soft reveal group relative overflow-hidden p-5 sm:p-7"
                data-reveal
                style={`transition-delay:${i * 60}ms`}
              >
                <div class:list={['absolute inset-0 opacity-60', sabor.fondo]} aria-hidden="true" />
                <div class="relative flex items-start justify-between gap-4">
                  <div>
                    <span class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-vino/70">
                      {sabor.tag}
                    </span>
                    <h3 class="mt-1.5 font-display text-xl font-black tracking-tight sm:text-2xl">
                      {sabor.nombre}
                    </h3>
                  </div>
                  <CookieMark
                    class="h-12 w-12 shrink-0 drop-shadow-sm transition-transform duration-700 group-hover:rotate-[18deg] group-hover:scale-110 sm:h-20 sm:w-20"
                    tone={sabor.tone}
                    chip={sabor.chip}
                  />
                </div>
                <p class="relative mt-2 text-sm leading-relaxed text-vino">{sabor.desc}</p>
                <div class="relative mt-5 flex flex-col gap-1.5 border-t border-vino/15 pt-3.5 sm:flex-row sm:items-center sm:justify-between">
                  <span class="font-display text-base font-bold sm:text-lg">
                    $2.50 <span class="text-xs font-semibold text-vino/75">/ combo de 3</span>
                  </span>
                  <span class="text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-vino/70">
                    {sabor.nota}
                  </span>
                </div>
              </article>
            ))
          }
        </div>

        <div
          class="reveal mt-4 flex max-w-[34rem] flex-col items-start justify-between gap-5 rounded-3xl bg-blush-deep px-7 py-6 text-vino sm:flex-row sm:items-center"
          data-reveal
        >
          <div>
            <p class="text-[0.6rem] font-bold uppercase tracking-[0.24em] text-vino/65">El combo</p>
            <p class="mt-1 font-display text-2xl font-black tracking-tight">3 galletas por $2.50</p>
            <p class="mt-1 text-sm text-vino/80">Chocochips, vainilla o mitad y mitad.</p>
          </div>
          <a href="#pedir" class="btn-primary shrink-0">
            Pedir mi combo
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= PUBLICACIONES / REDES ================= -->
    <section id="feed" data-cookie="left" class="relative z-10 border-y border-vino/10 py-16 sm:py-24">
      <div class="container-page">
        <div class="max-w-[44rem] lg:ml-auto">
          <div class="reveal flex items-center gap-3" data-reveal>
            <span class="relative block h-12 w-12 overflow-hidden rounded-2xl border border-vino/15 bg-blush shadow-sm sm:h-14 sm:w-14">
              <img src="/logo-mark.png" alt="Logotipo de ¡Qué Galleta!" class="h-full w-full object-contain p-1.5" />
            </span>
            <span class="pill">En redes</span>
          </div>

          <h2
            class="reveal mt-6 font-display text-[clamp(2.2rem,4.6vw,3.8rem)] font-black leading-[0.94] tracking-[-0.03em]"
          >
            Se nos antoja<br />
            <span class="italic text-caramel-dark">verte por aquí.</span>
          </h2>

          <p class="reveal mt-5 max-w-md text-sm leading-relaxed text-vino" data-reveal>
            Lo que sale del horno, las promos del combo y algún antojo de más. Todo se publica
            primero en <span class="font-semibold">@quegalleta.mcbo</span>.
          </p>

          <div
            class="reveal mt-7 flex max-w-[44rem] items-center gap-4 rounded-[1.5rem] border border-vino/15 bg-paper/85 p-3.5 shadow-[0_20px_45px_-36px_rgba(42,25,0,0.55)] sm:p-4"
            data-reveal
          >
            <img
              src="/logo.jpeg"
              alt="Logo de ¡Qué Galleta! con el usuario @quegalleta.mcbo"
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
              class="h-16 w-16 shrink-0 rounded-2xl border border-vino/10 object-cover sm:h-20 sm:w-20"
            />
            <div class="min-w-0">
              <p class="text-[0.55rem] font-bold uppercase tracking-[0.2em] text-vino/60">
                Nuestra marca
              </p>
              <p class="mt-0.5 truncate font-display text-lg font-black leading-tight">
                @quegalleta.mcbo
              </p>
              <p class="mt-1 text-xs leading-relaxed text-vino/70">
                Síguenos para ver el horno en directo.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-10 grid max-w-[44rem] grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-5 lg:ml-auto">
          {
            [
              {
                src: '/publi1.jpeg',
                alt: 'Publicación de ¡Qué Galleta!: ¿Eres bueno en matemáticas?',
                tag: 'Comunidad',
                titulo: '¿Eres bueno en matemáticas?',
                nota: 'Sí, pero con galletas.',
              },
              {
                src: '/publi2.jpeg',
                alt: 'Publicación de ¡Qué Galleta!: 3 x 2.5$ en cookies',
                tag: 'Promo',
                titulo: '3 x $2.50 en cookies',
                nota: 'El combo que siempre funciona.',
              },
            ].map((post, i) => (
              <article class="feed-card reveal" data-reveal style={`transition-delay:${i * 80}ms`}>
                <div class="relative overflow-hidden rounded-[1.2rem] bg-blush">
                  <img
                    src={post.src}
                    alt={post.alt}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out hover:scale-[1.03]"
                  />
                  <span class="absolute left-3 top-3 rounded-full bg-cream/95 px-2.5 py-1 text-[0.55rem] font-bold uppercase tracking-[0.16em] text-vino shadow-sm">
                    {post.tag}
                  </span>
                </div>
                <div class="flex flex-col gap-1 px-2 pb-1 pt-3 sm:flex-row sm:items-end sm:justify-between sm:gap-3">
                  <div>
                    <p class="text-[0.55rem] font-bold uppercase tracking-[0.18em] text-vino/60">
                      Publicación
                    </p>
                    <p class="mt-0.5 font-display text-sm font-bold leading-tight sm:text-base">
                      {post.titulo}
                    </p>
                    <p class="mt-1 text-xs text-vino/70">{post.nota}</p>
                  </div>
                  <span class="shrink-0 text-[0.6rem] font-semibold text-vino/65">
                    @quegalleta.mcbo
                  </span>
                </div>
              </article>
            ))
          }
        </div>

        <div class="reveal mt-7 flex max-w-[44rem] flex-wrap items-center gap-3 lg:ml-auto" data-reveal>
          <a href={instagramUrl} class="btn-primary" target="_blank" rel="noopener">
            Seguir en Instagram
            <span aria-hidden="true">↗</span>
          </a>
          <a href={whatsappUrl} class="btn-ghost" target="_blank" rel="noopener">
            WhatsApp
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= CTA ================= -->
    <section
      id="pedir"
      data-cookie="right"
      class="relative z-10 flex min-h-[100svh] items-center py-24 lg:py-0"
    >
      <div class="container-page">
        <div class="max-w-xl">
          <span class="pill reveal" data-reveal>Hechas para antojo</span>
          <h2
            class="reveal mt-7 font-display text-[clamp(2.8rem,6vw,5.6rem)] font-black leading-[0.88] tracking-[-0.04em] text-balance"
            data-reveal
          >
            ¿Se te antojó?<br />
            <span class="italic text-caramel-dark">Pide tu combo.</span>
          </h2>
          <p class="reveal mt-7 max-w-md text-base leading-relaxed text-vino" data-reveal>
            Escríbenos y te decimos qué salió del horno hoy. Tres galletas por $2.50: chocochips,
            vainilla o mitad y mitad.
          </p>
          <div class="reveal mt-9 flex flex-wrap items-center gap-4" data-reveal>
            <a href={whatsappUrl} class="btn-primary" target="_blank" rel="noopener">
              Pedir mi combo
              <span aria-hidden="true">→</span>
            </a>
            <a href={whatsappUrl} class="btn-ghost" target="_blank" rel="noopener">
              WhatsApp
              <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="reveal mt-10 text-[0.65rem] font-semibold uppercase tracking-[0.24em] text-vino/70" data-reveal>
            Martes a domingo · 9:00 – 19:00 · {location}
          </p>
          <p class="reveal mt-3 text-sm text-vino/80" data-reveal>
            También puedes escribirnos por
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener"
              class="font-semibold underline decoration-vino/30 underline-offset-4 transition-colors hover:text-caramel-dark"
            >
              Instagram {instagramHandle}
            </a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer data-cookie="left" class="relative z-10 border-t border-vino/15 bg-cream-deep text-vino">
    <div class="container-page py-12 sm:py-16">
      <div class="max-w-[34rem] lg:ml-auto">
        <div class="flex items-center gap-3">
          <span class="relative block h-12 w-12 overflow-hidden rounded-2xl border border-vino/15 bg-blush shadow-sm">
            <img
              src="/logo.jpeg"
              alt="Logotipo de ¡Qué Galleta!"
              width="96"
              height="96"
              class="h-full w-full object-cover"
            />
          </span>
          <span class="font-display text-lg font-black uppercase tracking-tight">¡Qué Galleta!</span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-vino/80">
          Dos sabores, una receta honesta. Masa reposada, horno caliente y un combo de 3 por $2.50,
