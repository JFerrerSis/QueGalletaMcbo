              <li><a href="#feed" class="transition-colors hover:text-caramel-dark">Publicaciones</a></li>
              <li><a href="#pedir" class="transition-colors hover:text-caramel-dark">Hacer un pedido</a></li>
            </ul>
          </div>
          <div>
            <p class="text-[0.65rem] font-bold uppercase tracking-[0.22em] text-vino/65">Encuéntranos</p>
            <ul class="mt-4 space-y-2.5 text-sm text-vino">
