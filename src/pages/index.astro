  </footer>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    gsap.ticker.lagSmoothing(0);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------- Entrada del hero ---------- */
    if (!reduceMotion) {
      gsap.from('[data-hero] > *', {
        opacity: 0,
        y: 26,
        duration: 0.7,
        stagger: 0.08,
        ease: 'power3.out',
        delay: 0.15,
        clearProps: 'all',
      });
    }

    /* ---------- Reveals al hacer scroll ---------- */
    gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
      if (reduceMotion) {
        el.classList.add('is-visible');
        return;
      }

      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 92%',
          once: true,
        },
        onStart: () => el.classList.add('is-visible'),
      });
    });

    /* ---------- Pasos del showcase ---------- */
    const showcase = document.getElementById('proceso');
    const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
    const bar = document.getElementById('showcase-bar');
    const detail = document.getElementById('step-detail');

    if (showcase && steps.length) {
      let current = 0;
      let swapTimer = 0;

      ScrollTrigger.create({
        trigger: showcase,
        start: 'top top',
        end: 'bottom bottom',
        onUpdate: (self) => {
          const index = Math.min(steps.length - 1, Math.floor(self.progress * steps.length));

          if (index !== current) {
            current = index;
            steps.forEach((step, i) => step.classList.toggle('is-active', i === index));

            if (detail) {
              window.clearTimeout(swapTimer);
              detail.classList.add('is-swapping');
              swapTimer = window.setTimeout(() => {
                detail.textContent = steps[index].dataset.text ?? '';
                detail.classList.remove('is-swapping');
              }, 160);
            }
          }

          if (bar) bar.style.transform = `scaleX(${self.progress})`;
        },
      });
    }

    /* ---------- Nav con fondo al hacer scroll ---------- */
    const nav = document.getElementById('nav');

    if (nav) {
      ScrollTrigger.create({
        start: 40,
        end: 'max',
        onToggle: (self) => nav.classList.toggle('nav-scrolled', self.isActive),
      });
    }

    const refresh = () => ScrollTrigger.refresh();
    window.addEventListener('load', refresh);
    document.fonts?.ready.then(refresh);
  </script>
</Layout>
